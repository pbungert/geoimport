# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (SDK path, etc.)
local.properties

# Log files
*.log

# Android Studio / IntelliJ IDEA
# IDE project files churn on their own (indexing, SDK paths, device list);
# keep the whole directory out of version control.
*.iml
.idea/

# Android Studio captures / profiling
captures/
*.hprof

# NDK
.externalNativeBuild/
.cxx/

# Keystore and signing files (keep secrets out of version control)
*.jks
*.keystore
keystore.properties
signing.properties

# OS-generated files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# Google services 
google-services.json
